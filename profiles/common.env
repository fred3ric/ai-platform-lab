# Valeurs communes à tous les profils.
# Surchargeables dans profiles/local.env (ignoré par Git, voir local.env.example).

CLUSTER_NAME=ai-platform-lab
ARGOCD_NAMESPACE=argocd

# Argo CD : "stable" convient pour apprendre. La documentation d'Argo CD recommande
# de figer une version précise en production : à faire en semaine 4 (voir ROADMAP.md).
ARGOCD_REF=stable
# install.yaml inclut l'interface web. core-install.yaml est plus léger (sans interface).
ARGOCD_MANIFEST=install.yaml

# Branche suivie par Argo CD et URL du repo (obligatoire pour le GitOps).
GITOPS_REVISION=main
REPO_URL=

# Ollama sert le modèle LLM, hors du cluster.
OLLAMA_PORT=11434
# Adresse de la machine qui sert le modèle.
# Vide : détection automatique (passerelle du réseau Docker "kind").
OLLAMA_ADDR=
# Modèle à choisir en semaine 3 (voir docs/adr/0003-llm-local-first.md).
OLLAMA_MODEL=
